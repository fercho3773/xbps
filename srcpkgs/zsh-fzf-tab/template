# Template file for 'zsh-vi-mode'
pkgname=zsh-fzf-tab
version=1.3.0
revision=1
#hostmakedepends=""
#makedepends=""
depends="fzf"
short_desc="Replaces zsh selection menu with fzf"
maintainer="Orphan"
license="MIT"
homepage="https://github.com/aloxaf/fzf-tab"
distfiles="${homepage}/archive/refs/tags/v${version}.zip"
checksum=9d8ddf0ad41f718a0e8fbe20ae0a88be6678ed7d205628cc94acc8ca77adb51a

plugdir="usr/share/zsh/plugins"

do_install() {
	vmkdir ${plugdir}/${pkgname}
	vcopy lib ${plugdir}/${pkgname}/lib
	vinstall fzf-tab.plugin.zsh 644 ${plugdir}/${pkgname}
	vinstall fzf-tab.zsh 644 ${plugdir}/${pkgname}
	vlicense LICENSE
}
